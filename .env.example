# ---- Server ----
PORT=4021

# Public origin this service is reachable at. Used for absolute resource URLs in
# the /.well-known/x402 manifest — indexers need real URLs, not localhost.
# PUBLIC_URL=https://api.yourdomain.com

SERVICE_NAME=Package & Dependency Intelligence

# ---- Payments ----
# EVM address that receives payments (from `npm run gen-wallet` for testnet).
PAY_TO=0xYourAddressHere

# CAIP-2 network id.
#   eip155:84532 = Base Sepolia testnet (default; uses the free public facilitator)
#   eip155:8453  = Base MAINNET (real funds; requires the CDP keys below)
NETWORK=eip155:84532

# Testnet facilitator. Ignored when NETWORK is Base mainnet — mainnet always
# uses the Coinbase CDP facilitator.
FACILITATOR_URL=https://x402.org/facilitator

# ---- Coinbase CDP ----
# Required when NETWORK=eip155:8453 (mainnet), or when USE_CDP_FACILITATOR=true.
# Create at https://portal.cdp.coinbase.com/api-keys/secret
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Only needed to CREATE/CONTROL CDP-managed wallets (`npm run cdp-wallet`).
# Not needed merely to receive payments — receiving needs only an address.
# Create at https://portal.cdp.coinbase.com/wallets/non-custodial/security
# CDP_WALLET_SECRET=

# Opt in to the CDP facilitator while still on testnet, to rehearse the real
# settlement path with test funds. Run `npm run cdp-check` first to confirm the
# CDP facilitator actually serves Base Sepolia. Mainnet always uses CDP.
# USE_CDP_FACILITATOR=true

# ---- MCP wrapper (buyer side; only needed to *call* a paid API) ----
# Private key of a wallet funded with USDC on the chosen network.
# This is the agent operator's key, not the API operator's.
# X402_PRIVATE_KEY=
API_URL=http://localhost:4021
